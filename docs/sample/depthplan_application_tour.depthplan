      "name": "Nested & numbered lists",
      "content": [
        {
          "type": "heading",
          "level": 2,
          "runs": [
            {
              "text": "A small tour checklist"
            }
          ]
        },
        {
          "type": "list",
          "ordered": true,
          "start": 3,
          "items": [
            [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "Select a parent container."
                  }
                ]
              },
              {
                "type": "list",
                "ordered": false,
                "items": [
                  [
                    {
                      "type": "paragraph",
                      "runs": [
                        {
                          "text": "Increase its displayed depth."
                        }
                      ]
                    }
                  ],
                  [
                    {
                      "type": "paragraph",
                      "runs": [
                        {
                          "text": "Collapse one branch independently."
                        }
                      ]
                    }
                  ]
                ]
              }
            ],
            [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "Apply a saved bookmark."
                  }
                ]
              }
            ],
            [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "Save and reopen the document."
                  }
                ]
              }
            ]
          ]
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "This numbered list deliberately starts at 3."
            }
          ]
        }
      ],
      "geometry": {
        "x": 720,
        "y": -650,
        "width": 620,
        "height": 530,
        "rotation": 0,
        "z": 0
      },
      "style": {
        "fill": "#fffdf7",
        "stroke": "#aa7935",
        "strokeWidth": 2,
        "cornerRadius": 12
      }
