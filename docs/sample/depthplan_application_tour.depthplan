    "rich-quote": {
      "id": "rich-quote",
      "parentId": "rich",
      "type": "rectangle",
      "name": "Quotes & links",
      "content": [
        {
          "type": "heading",
          "level": 2,
          "runs": [
            {
              "text": "Context stays close to the diagram"
            }
          ]
        },
        {
          "type": "quote",
          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "One diagram can serve several audiences."
                }
              ]
            },
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "Keep the explanation with the structure.",
                  "marks": {
                    "italic": true
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "TypeScript documentation",
              "marks": {
                "underline": true,
                "color": "#3569aa",
                "link": "https://www.typescriptlang.org/docs/"
              }
            }
          ]
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "This link is document content; no network access is required to view the sample."
            }
          ]
        }
      ],
      "geometry": {
        "x": -720,
        "y": -50,
        "width": 620,
        "height": 500,
        "rotation": 0,
        "z": 0
      },
      "style": {
