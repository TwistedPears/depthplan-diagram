      }
    },
    "rich-align": {
      "id": "rich-align",
      "parentId": "rich",
      "type": "rectangle",
      "name": "Paragraph alignment",
      "content": [
        {
          "type": "heading",
          "level": 2,
          "runs": [
            {
              "text": "Four alignments"
            }
          ]
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "Left aligned: ordinary explanation."
            }
          ],
          "align": "left"
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "Centered: a short caption."
            }
          ],
          "align": "center"
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "Right aligned: a small annotation."
            }
          ],
          "align": "right"
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "Justified paragraphs distribute words across the available line width. This example contains enough text to wrap and make the spacing visible in a wide card."
            }
          ],
          "align": "justify"
        }
      ],
      "geometry": {
        "x": 0,
        "y": -50,
