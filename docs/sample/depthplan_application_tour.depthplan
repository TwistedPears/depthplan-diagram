      }
    },
    "rich-transfer": {
      "id": "rich-transfer",
      "parentId": "rich",
      "type": "rectangle",
      "name": "Chunked MCP content",
      "content": [
        {
          "type": "heading",
          "level": 2,
          "runs": [
            {
              "text": "Assembled before publication"
            }
          ]
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "This card was transferred in multiple MCP chunks, then applied as one atomic rich-content edit."
            }
          ]
        },
        {
          "type": "code",
          "text": "begin → append → append → edit_object",
          "language": "plaintext",
          "wrap": true
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "Offsets count UTF-16 code units. Literal text survives: \\n, <tag>, &, “quotes”, 日本語 and ✓."
            }
          ]
        }
      ],
