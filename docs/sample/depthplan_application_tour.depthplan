  "objects": {
    "guide": {
      "id": "guide",
      "parentId": null,
      "type": "rectangle",
      "name": "START HERE • DepthPlan feature tour",
      "content": [
        {
          "type": "heading",
          "level": 1,
          "runs": [
            {
              "text": "DepthPlan, explained with DepthPlan"
            }
          ]
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "A working application map and a hands-on sample. Every diagram object, connection and saved view was authored through the live MCP server."
            }
          ]
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "Open Bookmarks and start with 01 • System overview."
                  }
                ]
              }
            ],
            [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "Continue through architecture, deep implementation, rich text, code languages and connection notation."
                  }
                ]
              }
            ],
            [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "Select a container to change its depth or collapse one branch. Use Undo to explore safely."
                  }
                ]
              }
            ]
          ]
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "Saved views retain depth, branch visibility, positions, sizes and camera. Text and style edits are shared across every view.",
              "marks": {
                "italic": true
              }
            }
          ]
        }
      ],
      "geometry": {
        "x": 1000,
        "y": -80,
        "width": 1400,
        "height": 340,
        "rotation": 0,
        "z": 0
      },
