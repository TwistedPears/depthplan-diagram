{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DepthPlan",
  "version": "0.1.0",
  "identifier": "com.twistedpears.depthplan",
  "build": {
    "beforeDevCommand": "npm run build:renderer && node scripts/prepare-native.mjs --debug && node scripts/check-licenses.cjs && npm run dev:renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:renderer && node scripts/prepare-native.mjs && node scripts/check-licenses.cjs",
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../assets/icon.png", "../assets/icon.icns", "../assets/icon.ico"],
    "category": "DeveloperTool",
    "fileAssociations": [
      {
        "ext": ["depthplan"],
        "name": "DepthPlan document",
        "description": "DepthPlan diagram",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-depthplan",
        "exportedType": {
          "identifier": "com.twistedpears.depthplan.document",
          "conformsTo": ["public.json"]
        }
      },
      {
        "ext": ["depthproject"],
        "name": "DepthPlan project",
        "description": "DepthPlan project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-depthproject",
        "exportedType": {
          "identifier": "com.twistedpears.depthplan.project",
          "conformsTo": ["public.json"]
        }
      }
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../COMMERCIAL-TERMS.md": "COMMERCIAL-TERMS.md",
      "generated/RUST-LICENSES.json": "licenses/RUST-LICENSES.json",
      "../out/tauri-renderer/THIRD-PARTY-LICENSES.json": "licenses/JAVASCRIPT-LICENSES.json",
      "../assets/project.icns": "project.icns",
      "../assets/project.ico": "project.ico"
    },
    "externalBin": ["binaries/depthplan-mcp"],
    "linux": {
      "deb": {
        "desktopTemplate": "mime/depthplan.desktop",
        "files": {
          "/usr/share/mime/packages/depthplan.xml": "mime/depthplan.xml",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-depthplan.png": "../assets/icon.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-depthproject.png": "../assets/project.png"
        }
      },
      "rpm": {
        "desktopTemplate": "mime/depthplan.desktop",
        "files": {
          "/usr/share/mime/packages/depthplan.xml": "mime/depthplan.xml",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-depthplan.png": "../assets/icon.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-depthproject.png": "../assets/project.png"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/mime/packages/depthplan.xml": "mime/depthplan.xml",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-depthplan.png": "../assets/icon.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-x-depthproject.png": "../assets/project.png"
        }
      }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/project-icon.nsh"
      }
    }
  }
}
